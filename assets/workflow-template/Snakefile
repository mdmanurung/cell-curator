"""Portable phase skeleton for adaptive assay-aware annotation.

Copy this directory into a project run workspace. Configure all paths, keys,
environments, resources, and marker programs in config.yaml. Add project-specific
heavy scripts as explicit rule inputs so their hashes enter provenance.
"""

from pathlib import Path

configfile: "config.yaml"

RUN = Path(config["run"]["output_root"]) / config["run"]["run_id"]
SCRIPTS = Path(config.get("skill_scripts", "scripts"))


rule all_evidence:
    input:
        RUN / "review_packet" / "review_packet.manifest.json"


rule inspect_input_contract:
    output:
        context=RUN / "context.md",
        state=RUN / "run_state.json",
        manifest=RUN / "input_contract.manifest.json",
    shell:
        "python {SCRIPTS}/inspect_input_contract.py --config config.yaml "
        "--output-root {RUN}"


rule audit_parents:
    input:
        contract=RUN / "input_contract.manifest.json",
        cells=RUN / "prepared" / "cells.tsv",
    output:
        RUN / "adaptive_parent_audit.tsv",
    shell:
        "python {SCRIPTS}/audit_parents.py --config config.yaml "
        "--cells {input.cells} --output {output}"


rule discover_candidates:
    input:
        audit=RUN / "adaptive_parent_audit.tsv",
        parents=RUN / "prepared" / "parent_membership.tsv",
        stored=RUN / "prepared" / "stored_membership_long.tsv",
        local=RUN / "prepared" / "parent_local_candidates.tsv",
    output:
        registry=RUN / "discovery" / "candidate_registry.tsv",
        membership=RUN / "discovery" / "candidate_membership.tsv",
        triage=RUN / "discovery" / "parent_triage.tsv",
        families=RUN / "discovery" / "stored_family_ledger.tsv",
        manifest=RUN / "discovery" / "discovery.manifest.json",
    shell:
        "python {SCRIPTS}/discover_candidates.py --config config.yaml "
        "--parents {input.parents} --stored-memberships {input.stored} "
        "--local-candidates {input.local} --audit {input.audit} "
        "--output-dir {RUN}/discovery"


rule validate_candidate_registry:
    input:
        audit=RUN / "adaptive_parent_audit.tsv",
        registry=RUN / "discovery" / "candidate_registry.tsv",
        membership=RUN / "discovery" / "candidate_membership.tsv",
    output:
        RUN / "discovery" / "candidate_registry.validated.json",
    shell:
        "python {SCRIPTS}/validate_candidate_registry.py --config config.yaml "
        "--audit {input.audit} --registry {input.registry} "
        "--membership {input.membership} --output {output}"


rule build_binary_comparators:
    input:
        validated=RUN / "discovery" / "candidate_registry.validated.json",
        registry=RUN / "discovery" / "candidate_registry.tsv",
        membership=RUN / "discovery" / "candidate_membership.tsv",
        cells=RUN / "prepared" / "cells.tsv",
    output:
        RUN / "contrasts" / "comparator_manifest.tsv",
    shell:
        "python {SCRIPTS}/build_candidate_contrasts.py --config config.yaml "
        "--cells {input.cells} --registry {input.registry} "
        "--membership {input.membership} --output-dir {RUN}/contrasts"


# Generate a backend-specific marker job per comparator-manifest row. Rows with
# backend=rapids_singlecell invoke rank_markers_gpu.py and write GPU receipts.
# A required RAPIDS lane has no CPU replacement. Other backends use separate
# rules and immutable receipts.


rule validate_gpu_receipts:
    input:
        lanes=RUN / "contrasts" / "comparator_manifest.tsv",
        # Add the expanded receipt files as explicit inputs in the project DAG.
    output:
        RUN / "gpu_markers" / "gpu_receipts.validated.json",
    shell:
        "python {SCRIPTS}/validate_gpu_receipts.py --config config.yaml "
        "--lane-registry {input.lanes} --receipts-root {RUN}/gpu_markers "
        "--output {output}"


# Add deterministic rules for absolute evidence, feature-space-compatible
# enrichment, technical/doublet summaries, cards, and critic inputs. Make their
# completion manifests inputs of build_review_packet.

# Use summarize_multimodal_evidence.py for each binary lane and
# evaluate_candidate_evidence.py to create child_evidence_summary.tsv and the
# one-row-per-parent decision template after all evidence tables are present.


rule build_review_packet:
    input:
        contract=RUN / "input_contract.manifest.json",
        registry=RUN / "discovery" / "candidate_registry.validated.json",
        gpu=RUN / "gpu_markers" / "gpu_receipts.validated.json",
    output:
        directory(RUN / "review_packet"),
    shell:
        "python {SCRIPTS}/build_review_packet.py --config config.yaml "
        "--run-root {RUN}"


# No finalizer or write-back rule belongs in a default/aggregate target.
